#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = ">>=";
            bindings = <
                &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
                &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                               &kp LGUI &kp SPACE &mo 1   &mo 2 &kp RET &kp RALT
            >;
        };

        nav {
            display-name = "_|_";
            bindings = <
                &kp TAB    &kp N1  &kp N2   &kp N3    &kp N4    &kp N5    &kp N6   &kp N7   &kp N8 &kp N9    &kp N0  &kp BSPC
                &kp LCTRL  &kp INS &kp HOME &kp PG_DN &kp PG_UP &kp END   &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp DEL &kp F12
                &kp LSHFT  &kp F1  &kp F2   &kp F3    &kp F4    &kp F5    &kp F6   &kp F7   &kp F8 &kp F9    &kp F10 &kp F11
                                            &kp LGUI  &kp SPACE &trans    &trans   &kp RET  &kp RALT
            >;
        };

        sym {
            display-name = "-*>";
            bindings = <
                &kp TAB   &kp EXCL   &kp AT     &kp HASH   &kp DLLR     &kp PRCNT     &kp CARET &kp AMPS  &kp STAR &kp LPAR &kp RPAR &kp BSPC
                &kp LCTRL &kp C_PREV &kp C_PP   &kp C_NEXT &kp C_VOL_UP &kp C_BRI_UP  &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH &kp GRAVE
                &kp LSHFT &kp C_RW   &kp C_MUTE &kp C_FF   &kp C_VOL_DN &kp C_BRI_DN  &kp UNDER &kp PLUS  &kp LBRC &kp RBRC &kp PIPE &kp TILDE
                                                &kp LGUI   &kp SPACE    &trans        &trans    &kp RET   &kp RALT
            >;
        };

        con {
            display-name = "<->";
            bindings = <
                &mo TAB   &none        &none        &none        &none        &none         &none  &none   &none    &none &none &kp BSPC
                &kp LCTRL &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4  &none  &none   &none    &none &none &none 
                &bt LSHFT &none        &none        &none        &none        &none         &none  &none   &none    &none &none &kp DEL
                                                    &kp LGUI     &kp SPACE    &mo NAV       &mo 2  &kp RET &kp RALT
            >;
        };


        mouse {
            display-name = "[ ]";
            bindings = <
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                            &mkp LCLK &mkp MCLK &mkp RCLK           &mkp LCLK &mkp MCLK &mkp RCLK
            >;
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
